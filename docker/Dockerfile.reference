# CPU PyTorch reference: produces golden tensors the HIP engine is validated against.
FROM ubuntu:26.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv
ENV PATH=/venv/bin:$PATH
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install --no-cache-dir "transformers>=4.48" safetensors numpy tokenizers
WORKDIR /ref
COPY rl_common.py rl_agent_api.py gen_golden.py ./
ENTRYPOINT ["python3","gen_golden.py"]
